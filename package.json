{
  "name": "lingopulse-monorepo",
  "version": "1.0.0",
  "description": "Production-ready Duolingo-inspired mobile language learning platform",
  "private": true,
  "scripts": {
    "seed": "npm run seed --prefix backend",
    "test:backend": "npm test --prefix backend",
    "test:curriculum": "tsx scripts/validateCurriculum.ts",
    "test:e2e": "playwright test",
    "test:all": "npm run test:backend && npm run test:curriculum && npm run test:e2e",
    "dev:backend": "npm run dev --prefix backend",
    "dev:admin": "npm run dev --prefix admin",
    "dev:mobile": "npm run start --prefix mobile",
    "build:backend": "npm run build --prefix backend",
    "build:admin": "npm run build --prefix admin",
    "build:shared": "npm run build --prefix shared"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "mongoose": "^9.11.4"
  }
}
